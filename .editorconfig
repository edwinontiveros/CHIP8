# EditorConfig configuration
# https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100
guidelines = 100
guidelines_style=1.5px dotted green

# C and C++
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,ipp,inl,ixx,cppm}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

# Border guidelines
guidelines = 100
guidelines_style=1.2px dotted teal

# Microsoft-style C++ formatting in Visual Studio
cpp_indent_braces = false
cpp_indent_namespace_contents = true
cpp_indent_access_specifiers = false
cpp_indent_case_contents = true
cpp_indent_case_labels = false
cpp_indent_case_contents_when_block = false
cpp_indent_preprocessor = leftmost_column
cpp_indent_preserve_comments = true
cpp_indent_multi_line_relative_to = outermost_parenthesis
cpp_indent_within_parentheses = indent

# Allman braces
cpp_new_line_before_open_brace_namespace = new_line
cpp_new_line_before_open_brace_type = new_line
cpp_new_line_before_open_brace_function = new_line
cpp_new_line_before_open_brace_block = new_line
cpp_new_line_before_open_brace_lambda = new_line
cpp_new_line_scope_braces_on_separate_lines = true

# Empty bodies
cpp_new_line_close_brace_same_line_empty_type = false
cpp_new_line_close_brace_same_line_empty_function = false

# Control flow
cpp_new_line_before_catch = true
cpp_new_line_before_else = true
cpp_new_line_before_while_in_do_while = true

# Spacing
cpp_space_after_keywords_in_control_flow_statements = true
cpp_space_within_control_flow_statement_parentheses = false
cpp_space_before_function_open_parenthesis = remove
cpp_space_within_parameter_list_parentheses = false
cpp_space_between_empty_parameter_list_parentheses = false
cpp_space_before_block_open_brace = true
cpp_space_before_comma = false
cpp_space_after_comma = true
cpp_space_remove_before_semicolon = true
cpp_space_after_semicolon = true
cpp_space_around_binary_operator = insert
cpp_space_around_assignment_operator = insert
cpp_space_around_ternary_operator = insert
cpp_space_pointer_reference_alignment = left
cpp_space_remove_around_member_operators = true
cpp_space_before_inheritance_colon = true
cpp_space_before_constructor_colon = true

# Python
[*.py]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
max_line_length = 80

# CMake
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2
tab_width = 2
end_of_line = crlf
max_line_length = 80

# JSON
[*.json]
indent_style = space
indent_size = 2
tab_width = 2

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Windows batch scripts
[*.{bat,cmd}]
end_of_line = crlf

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
tab_width = 2
end_of_line = crlf
